generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  owner
  admin
  viewer
}

// ─── Multi-site support ───────────────────────────────────────────────────────

model Site {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  niche     String?
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers  Offer[]
  clicks  AffiliateClick[]
  pages   Page[]
  campaigns Campaign[]
  conversions Conversion[]
}

// ─── Affiliate Offers ─────────────────────────────────────────────────────────

model Offer {
  id               String       @id @default(cuid())
  siteId           String
  name             String
  category         String
  brand            String?
  slug             String       @unique
  destinationUrl   String
  fallbackUrl      String?
  payoutAmount     Float?
  currency         String       @default("USD")
  status           OfferStatus  @default(active)
  subIdParamName   String?
  appendClickId    Boolean      @default(true)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  site        Site             @relation(fields: [siteId], references: [id])
  clicks      AffiliateClick[]
  conversions Conversion[]
  targetedPages Page[]
}

enum OfferStatus {
  active
  paused
  placeholder
  archived
}

// ─── Click Tracking ───────────────────────────────────────────────────────────

model AffiliateClick {
  id           String   @id @default(cuid())
  clickId      String   @unique @default(uuid())
  siteId       String
  offerId      String
  pageUrl      String?
  referrer     String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  userAgent    String?
  device       String?
  browser      String?
  os           String?
  ipHash       String?
  country      String?
  redirectedTo String?
  status       String   @default("redirected")
  isLikelyBot  Boolean  @default(false)
  createdAt    DateTime @default(now())

  site        Site         @relation(fields: [siteId], references: [id])
  offer       Offer        @relation(fields: [offerId], references: [id])
  conversions Conversion[]
}

// ─── Conversions ──────────────────────────────────────────────────────────────

model Conversion {
  id             String           @id @default(cuid())
  clickId        String
  offerId        String
  siteId         String
  payoutAmount   Float?
  currency       String           @default("USD")
  network        String?
  transactionId  String?
  status         ConversionStatus @default(pending)
  conversionDate DateTime         @default(now())
  rawPayload     Json?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  click  AffiliateClick @relation(fields: [clickId], references: [clickId])
  offer  Offer          @relation(fields: [offerId], references: [id])
  site   Site           @relation(fields: [siteId], references: [id])
}

enum ConversionStatus {
  pending
  approved
  rejected
  paid
}

// ─── Pages (with E-E-A-T fields) ─────────────────────────────────────────────

model Page {
  id                 String     @id @default(cuid())
  siteId             String
  title              String
  slug               String
  url                String
  pageType           PageType
  category           String?
  primaryKeyword     String?
  secondaryKeywords  String[]
  metaTitle          String?
  metaDescription    String?
  status             PageStatus @default(draft)
  targetOfferId      String?
  lastUpdated        DateTime?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // E-E-A-T fields (Section 10 of PRD)
  citedSources          Json?
  medicallyReviewedBy   String?
  reviewerCredentials   String?
  reviewerLicenseState  String?
  lastReviewedDate      DateTime?
  authorBio             String?

  site         Site   @relation(fields: [siteId], references: [id])
  targetOffer  Offer? @relation(fields: [targetOfferId], references: [id])
}

enum PageType {
  home
  category
  benefits
  side_effects
  cost
  blog_post
  static
  injection_types
}

enum PageStatus {
  draft
  published
  needs_update
  archived
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  source    String?
  medium    String?
  campaign  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id])
}
