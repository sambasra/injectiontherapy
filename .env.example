# ─── Database ─────────────────────────────────────────────────────────────────
# Railway me PostgreSQL service add karo — Railway auto-injects DATABASE_URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/injectiontherapy"

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-char-random-string-here"

# ─── Admin Setup ──────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@injectiontherapy.org"
ADMIN_INITIAL_PASSWORD="ChangeThisImmediately!"

# ─── Postback Token ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
POSTBACK_SECRET_TOKEN="replace-with-secure-random-token"

# ─── Public URLs ──────────────────────────────────────────────────────────────
# Railway me auto-generate hoga, ya custom domain set karo
NEXT_PUBLIC_SITE_URL="https://your-app.up.railway.app"
NEXT_PUBLIC_SITE_NAME="InjectionTherapy.org"

# ─── Affiliate Offer URLs (admin panel me bhi set kar sakte ho) ──────────────
OFFER_URL_B12="https://your-affiliate-link.com/b12"
OFFER_URL_GLP1="https://your-affiliate-link.com/glp1"
OFFER_URL_NAD="https://your-affiliate-link.com/nad"
