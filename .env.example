# Database
DATABASE_URL="postgresql://user:password@localhost:5432/injectiontherapy"

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-char-random-string"

# Admin credentials (set up via seed or admin panel after first deploy)
ADMIN_EMAIL="admin@injectiontherapy.org"

# Postback security token — generate with: openssl rand -hex 32
POSTBACK_SECRET_TOKEN="replace-with-secure-token"

# Site config
NEXT_PUBLIC_SITE_URL="https://injectiontherapy.org"
NEXT_PUBLIC_SITE_NAME="InjectionTherapy.org"
